<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bitejiuyeke.biteportalservice.flash.mapper.ChatHistoryMapper">

    <select id="selectChatHistory"
            parameterType="com.bitejiuyeke.biteportalservice.flash.domain.dto.require.ChatHistoryReqParam"
            resultType="com.bitejiuyeke.biteportalservice.flash.domain.entity.ChatHistoryDO">
        SELECT h.id, h.app_id, h.chat_role, h.content
        FROM chat_history h
        INNER JOIN app a ON a.id = h.app_id
        WHERE a.user_id = #{userId}
          AND h.is_deleted = 0
        ORDER BY h.id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countChatHistory"
            parameterType="com.bitejiuyeke.biteportalservice.flash.domain.dto.require.ChatHistoryReqParam"
            resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM chat_history h
        INNER JOIN app a ON a.id = h.app_id
        WHERE a.user_id = #{userId}
          AND h.is_deleted = 0
    </select>
</mapper>
